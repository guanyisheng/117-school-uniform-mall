.status-card {
  margin: 20rpx 24rpx;
  padding: 32rpx;
}

.status {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1565FF;
}

.time {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.section {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
}

.product-row {
  display: flex;
  margin-bottom: 20rpx;
}

.thumb {
  width: 140rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
}

.name {
  display: block;
  font-size: 28rpx;
}

.meta {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.amount {
  font-weight: 600;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.addr-name {
  display: block;
  font-size: 28rpx;
}

.addr-detail {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  line-height: 1.5;
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.btn {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  background: #f5f5f5;
  color: #333;
  border-radius: 12rpx;
  line-height: 80rpx;
  height: 80rpx;
}

.btn.primary {
  background: #1565FF;
  color: #fff;
}

.btn::after {
  border: none;
}
