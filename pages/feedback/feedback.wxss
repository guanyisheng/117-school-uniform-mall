.form-card {
  margin: 24rpx;
  padding: 8rpx 32rpx 32rpx;
}

.form-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
}

.feedback-textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.form-input {
  font-size: 30rpx;
  color: #333;
  width: 100%;
}

.submit-wrap {
  padding: 48rpx 24rpx;
}

.submit-btn {
  width: 100%;
}
