<view class="container">
  <view class="form-card card">
    <view class="form-item">
      <text class="label">商品图片</text>
      <view class="img-list">
        <view class="img-item img-portrait-34" wx:for="{{images}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFit" />
          <text class="img-del" data-index="{{index}}" catchtap="onRemoveImage">×</text>
        </view>
        <view class="img-add img-portrait-34" bindtap="onChooseImage" wx:if="{{images.length < 9}}">
          <text>+</text>
        </view>
      </view>
      <text class="tip">竖图 3:4 或 9:16，完整显示不裁切</text>
    </view>
    <view class="form-item">
      <text class="label">名称</text>
      <input placeholder="如：鲁甸二中春夏校服" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="form-item">
      <text class="label">价格（元）</text>
      <input type="digit" placeholder="如：268" value="{{price}}" bindinput="onPriceInput" />
    </view>
    <view class="form-item">
      <text class="label">尺码（逗号分隔）</text>
      <input placeholder="如：S,M,L,XL" value="{{sizesText}}" bindinput="onSizesInput" />
    </view>
    <view class="form-item">
      <text class="label">学校</text>
      <picker mode="selector" range="{{schoolNames}}" value="{{schoolIndex}}" bindchange="onSchoolChange">
        <view class="picker {{schoolIndex < 0 ? 'placeholder' : ''}}">
          {{schoolIndex >= 0 ? schoolNames[schoolIndex] : '请选择'}}
        </view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">描述</text>
      <textarea placeholder="面料、款式说明等" value="{{intro}}" bindinput="onIntroInput" auto-height />
    </view>
  </view>
  <view class="submit-wrap">
    <button class="btn-primary" bindtap="onSubmit">{{isEdit ? '保存修改' : '提交上架'}}</button>
  </view>
</view>
