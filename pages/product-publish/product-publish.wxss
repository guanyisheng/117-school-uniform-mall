.form-card {
  margin: 20rpx 24rpx;
  padding: 8rpx 24rpx 24rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

input, textarea, .picker {
  font-size: 28rpx;
  color: #333;
  width: 100%;
}

.picker.placeholder {
  color: #ccc;
}

.img-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-item, .img-add {
  width: 200rpx;
  position: relative;
}

.img-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 28rpx;
}

.img-add {
  border: 1rpx dashed #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #ccc;
}

.tip {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 12rpx;
}

.submit-wrap {
  padding: 40rpx 24rpx;
}

.submit-wrap .btn-primary {
  width: 100%;
}
