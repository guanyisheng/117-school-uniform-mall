.login-header {
  padding: 48rpx 32rpx 32rpx;
}

.login-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.login-sub {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.mode-tabs {
  display: flex;
  gap: 24rpx;
  padding: 16rpx 0 8rpx;
}

.mode-tab {
  font-size: 28rpx;
  color: #999;
  padding-bottom: 12rpx;
}

.mode-tab.active {
  color: #1565FF;
  font-weight: 500;
  border-bottom: 4rpx solid #1565FF;
}

.form-card {
  margin: 0 24rpx;
  padding: 8rpx 32rpx 40rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.form-input {
  font-size: 30rpx;
  color: #333;
  width: 100%;
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  background: transparent;
}

.code-row {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
}

.code-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #1565FF;
  padding: 8rpx 0 8rpx 24rpx;
  margin-left: 16rpx;
}

.code-btn.disabled {
  color: #999;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
  padding: 8rpx 0;
}

.picker-value.placeholder {
  color: #ccc;
}

.submit-btn {
  margin-top: 40rpx;
  width: 100%;
}
