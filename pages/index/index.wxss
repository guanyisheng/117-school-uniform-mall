.page {
  width: 100%;
  overflow: hidden;
  background: #f5f7fa;
}

.page-swiper {
  width: 100%;
  overflow: hidden;
}

.panel-item {
  height: 100%;
  overflow: hidden;
}

.panel-home {
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow: hidden;
  box-sizing: border-box;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  background: #f5f7fa;
}

.hero-area {
  position: relative;
  width: 100%;
  flex-shrink: 0;
  overflow: hidden;
  background: #e8ecf2;
}

.hero-fullscreen,
.hero-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.hero-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.8s ease-in-out;
  z-index: 0;
}

.hero-img--active {
  opacity: 1;
  z-index: 1;
}

.hero-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  z-index: 10;
}

.hero-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
  transition: background 0.3s ease, transform 0.3s ease;
}

.hero-dot--active {
  background: #1565FF;
  transform: scale(1.15);
}

.panel-menu {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 12rpx 24rpx 0;
  box-sizing: border-box;
  min-height: 0;
}

.panel-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 12rpx;
  pointer-events: none;
}

.panel-hint-text {
  font-size: 22rpx;
  color: #666666;
}

.panel-hint-arrow {
  width: 16rpx;
  height: 16rpx;
  margin-top: 8rpx;
  border-right: 3rpx solid #999999;
  border-bottom: 3rpx solid #999999;
  transform: rotate(45deg);
  animation: hint-bounce 1.6s ease-in-out infinite;
}

@keyframes hint-bounce {
  0%, 100% { transform: rotate(45deg) translateY(0); opacity: 0.6; }
  50% { transform: rotate(45deg) translateY(8rpx); opacity: 1; }
}

.quick-glass {
  width: 100%;
  border-radius: 28rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.quick-glass-inner {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx 28rpx;
  background: rgba(255, 255, 255, 0.62);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 12rpx 48rpx rgba(15, 30, 60, 0.12);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.quick-name {
  font-size: 24rpx;
  color: #333333;
  margin-top: 12rpx;
  line-height: 1.2;
  font-weight: 500;
}

.panel-all {
  width: 100%;
  background: #F5F7FA;
}

.below-section {
  padding: 32rpx 24rpx calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  padding: 0 4rpx;
  gap: 16rpx;
}

.section-title {
  position: relative;
  padding-left: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.2;
  flex-shrink: 0;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: #1565FF;
  border-radius: 3rpx;
}

.filter-tag {
  flex: 1;
  font-size: 24rpx;
  color: #1565FF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-more {
  margin-left: auto;
  font-size: 24rpx;
  color: #1565FF;
  padding: 10rpx 20rpx;
  background: rgba(21, 101, 255, 0.08);
  border-radius: 999rpx;
  flex-shrink: 0;
}

.product-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
