.tabs {
  margin: 20rpx 24rpx;
  display: flex;
  padding: 8rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 12rpx;
}

.tab.active {
  color: #1565FF;
  background: rgba(21, 101, 255, 0.08);
  font-weight: 500;
}

.order-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
}

.head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.oid {
  font-size: 24rpx;
  color: #999;
}

.status {
  font-size: 24rpx;
  color: #1565FF;
}

.body {
  display: flex;
}

.thumb {
  width: 140rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
}

.name {
  display: block;
  font-size: 28rpx;
  color: #333;
}

.meta {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.amount {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 12rpx;
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  gap: 16rpx;
}

.act {
  margin: 0;
  font-size: 24rpx !important;
}

.act.primary {
  background: #1565FF !important;
  color: #fff !important;
}
