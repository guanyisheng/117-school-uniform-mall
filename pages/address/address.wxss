.address-list {
  padding: 24rpx 24rpx 160rpx;
}

.address-card {
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.addr-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}

.addr-phone {
  font-size: 28rpx;
  color: #666;
}

.default-tag {
  margin-left: auto;
  font-size: 22rpx;
  color: #1565FF;
  background: rgba(21, 101, 255, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.addr-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.addr-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
  gap: 24rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #1565FF;
  padding: 8rpx 20rpx;
}

.action-btn.danger {
  color: #FF4D4F;
}

.add-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.add-btn {
  width: 100%;
}
