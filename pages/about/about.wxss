.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: env(safe-area-inset-bottom);
}

.card {
  margin: 20rpx 24rpx 0;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(21, 101, 255, 0.06);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 40rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.company {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
}

.version {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #bbb;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1565ff;
  margin-bottom: 20rpx;
}

.body-text {
  display: block;
  font-size: 28rpx;
  color: #555;
  line-height: 1.75;
}

.pre-line {
  white-space: pre-line;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.feature-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: #1565ff;
  flex-shrink: 0;
}

.feature-text {
  flex: 1;
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
}

.scope-text {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.6;
}

.scope-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.contact-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.contact-label {
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.contact-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  line-height: 1.5;
}

.contact-value.link {
  color: #1565ff;
}

.footer-space {
  height: 40rpx;
}
