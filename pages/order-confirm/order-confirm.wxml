<view class="container order-page">
  <view class="section card">
    <view class="product-row" wx:for="{{items}}" wx:key="productId">
      <view class="thumb img-portrait-34">
        <image src="{{item.cover}}" mode="aspectFit" />
      </view>
      <view class="product-info">
        <text class="name">{{item.productName}}</text>
        <text class="school" wx:if="{{item.size}}">尺码：{{item.size}}</text>
        <text class="school">数量：{{item.quantity}}</text>
        <text class="price">¥{{item.price}}</text>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-head">
      <text class="section-title">收货地址</text>
      <text class="section-link" bindtap="onAddAddress">新增</text>
    </view>
    <view wx:if="{{addresses.length}}">
      <view
        class="addr-item {{selectedAddrId === item.id ? 'active' : ''}}"
        wx:for="{{addresses}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSelectAddr"
      >
        <text class="addr-name">{{item.name}} {{item.phone}}</text>
        <text class="addr-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text>
      </view>
    </view>
    <view class="empty-addr" wx:else bindtap="onAddAddress">
      <text>请添加校服收货地址</text>
    </view>
  </view>

  <view class="pay-bar safe-bottom">
    <text class="pay-amount">{{priceText}}</text>
    <button class="pay-btn btn-primary" bindtap="onPay" disabled="{{paying}}">微信支付</button>
  </view>
</view>
