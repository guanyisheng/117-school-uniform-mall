.section {
  margin: 20rpx 24rpx;
  padding: 24rpx;
}

.product-row {
  display: flex;
  margin-bottom: 20rpx;
}

.product-row:last-child {
  margin-bottom: 0;
}

.thumb {
  width: 160rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
}

.name {
  display: block;
  font-size: 28rpx;
  color: #333;
}

.school {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.price {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-top: 16rpx;
  font-weight: 500;
}

.section-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.section-link {
  font-size: 26rpx;
  color: #1565FF;
}

.addr-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.addr-item:last-child {
  border-bottom: none;
}

.addr-item.active {
  background: rgba(21, 101, 255, 0.04);
  margin: 0 -16rpx;
  padding: 20rpx 16rpx;
  border-radius: 8rpx;
}

.addr-name {
  display: block;
  font-size: 28rpx;
  color: #333;
}

.addr-detail {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  line-height: 1.5;
}

.empty-addr {
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #1565FF;
}

.pay-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pay-amount {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.pay-btn {
  width: 240rpx;
  margin: 0;
}
