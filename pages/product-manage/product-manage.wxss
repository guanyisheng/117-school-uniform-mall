.toolbar {
  padding: 24rpx;
}

.add-btn {
  width: 100%;
  margin: 0;
}

.item {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  display: flex;
}

.thumb {
  width: 160rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
}

.name {
  display: block;
  font-size: 28rpx;
  color: #333;
}

.meta {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.status {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.status.on {
  color: #1565FF;
  background: rgba(21, 101, 255, 0.08);
}

.status.off {
  color: #999;
  background: #f5f5f5;
}

.actions {
  display: flex;
  gap: 28rpx;
  margin-top: 20rpx;
}

.link {
  font-size: 26rpx;
  color: #1565FF;
}

.link.danger {
  color: #FF4D4F;
}
