page {
  background-color: #F5F7FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.order-confirm.container,
.container.order-page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.btn-primary {
  background: #1565FF;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 88rpx;
  height: 88rpx;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.text-primary {
  color: #1565FF;
}

.text-muted {
  color: #999999;
}

.text-price {
  color: #FF4D4F;
  font-weight: 600;
}

.safe-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  gap: 16rpx;
}

.img-portrait {
  width: 100%;
  height: 100%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-portrait-tall {
  width: 100%;
  aspect-ratio: 9 / 16;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.img-portrait-34 {
  width: 100%;
  aspect-ratio: 3 / 4;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.img-portrait-34 image {
  width: 100%;
  height: 100%;
}

.empty-state-text {
  font-size: 28rpx;
  color: #999;
}
